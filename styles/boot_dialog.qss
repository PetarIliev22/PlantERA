QFrame#bootOverlay {
    background-color: #E9EEF3;
}

QFrame#bootCard {
    background-color: #FFFFFF;

    border: 1px solid #D9E1EA;
    border-radius: 18px;
}

QLabel#bootIcon {
    background-color: #EAF4FF;
    color: #1687F8;

    border: none;
    border-radius: 35px;

    font-family: Arial;
    font-size: 14px;
    font-weight: 700;
}

QLabel#bootIcon[state="success"] {
    background-color: #E9F8F1;
    color: #22B573;

    font-size: 30px;
    font-weight: 700;
}

QLabel#bootIcon[state="failed"] {
    background-color: #FDECEC;
    color: #E5484D;

    font-size: 30px;
    font-weight: 700;
}

QLabel#bootTitle {
    background-color: transparent;
    color: #172033;

    font-family: Arial;
    font-size: 21px;
    font-weight: 700;
}

QLabel#bootDescription {
    background-color: transparent;
    color: #738199;

    font-family: Arial;
    font-size: 14px;
}

QLabel#bootStatus {
    background-color: transparent;
    color: #1687F8;

    font-family: Arial;
    font-size: 14px;
    font-weight: 700;
}

QLabel#bootStatus[state="success"] {
    color: #22B573;
}

QLabel#bootStatus[state="failed"] {
    color: #E5484D;
}

QPushButton#bootButton {
    background-color: #F4F7FA;
    color: #172033;

    border: 1px solid #D9E1EA;
    border-radius: 9px;

    font-family: Arial;
    font-size: 14px;
}

QPushButton#bootButton:hover {
    background-color: #EAF4FF;
}

QPushButton#bootButton:pressed {
    background-color: #DCEEFF;
}