QMainWindow#mainWindow {
    background-color: transparent;
}

QWidget#mainContainer {
    background-color: #F4F7FA;
}

QWidget#mainContent {
    background-color: #f1f7fd;
}

QPushButton:focus {
    outline: none;
}

QFrame#dialogOverlay {
    background-color: rgba(15, 23, 42, 100);
    border: none;
}