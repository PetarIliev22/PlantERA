QFrame#deviceProfileCard {
    background-color: #FFFFFF;
    border: 1px solid #F3F3F3;
    border-radius: 15px;
}

QLabel#deviceProfileImage {
    background-color: transparent;
}

QLabel#deviceProfileTitle {
    color: #1687F8;
    font-size: 19px;
    font-weight: 600;
}

QLabel#deviceProfileSpecLabel {
    color: #8491A5;
    font-size: 12px;
    font-weight: 600;
}

QLabel#deviceProfileSpecValue {
    color: #444444;
    font-size: 12px;
    font-weight: 400;
}