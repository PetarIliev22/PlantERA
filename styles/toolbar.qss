QFrame#toolbar {
    background-color: #F8FAFD;
    border-image: url("assets/img/toolbar_bg.png") 0 0 0 0 stretch stretch;
    border: none;
}

QFrame#toolbarTitleFrame {
    background-color: transparent;
    border: none;
}

QLabel#toolbarTitle {
    background-color: transparent;
    color: #172B4D;
    font-size: 21px;
    font-weight: 700;
}

QLabel#toolbarSubtitle {
    background-color: transparent;
    color: #7186A3;
    font-size: 13px;
    font-weight: 400;
}

QFrame#toolbarBottomLine {
    background-color: #DCE6F2;
    border: none;
}

QPushButton#minimizeButton,
QPushButton#maximizeButton,
QPushButton#closeButton {
    margin-top: 4px;
    background-color: transparent;
    border: none;
    border-radius: 9px;
    padding: 0px;
}

QPushButton#minimizeButton:hover,
QPushButton#maximizeButton:hover {
    background-color: #E8F1FC;
}

QPushButton#minimizeButton:pressed,
QPushButton#maximizeButton:pressed {
    background-color: #D6E7FA;
}

QPushButton#closeButton:hover {
    background-color: #FDE8EC;
}

QPushButton#closeButton:pressed {
    background-color: #FBCDD6;
}
