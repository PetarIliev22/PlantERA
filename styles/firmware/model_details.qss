
/* MODEL DETAILS */

QFrame#modelDetailsCard {
    background-color: #FFFFFF;
    border: 1px solid #F3F3F3;
    border-radius: 15px;
}

QLabel#modelDetailsTitle {
    color: #1687F8;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QScrollArea#modelDetailsScroll {
    background: transparent;
    border: none;
}

QScrollArea#modelDetailsScroll > QWidget > QWidget {
    background: transparent;
}

QLabel#modelDetailsImage {
    background-color: #F5F8FC;
    border: none;
    border-radius: 10px;
}

QLabel#modelDetailsName {
    color: #172B4D;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#modelDetailsCode {
    color: #1687F8;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#modelDetailsMeta {
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#modelDetailsSectionTitle {
    color: #172B4D;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#modelSpecification {
    background-color: #F4F8FD;
    color: #334155;
    border: 1px solid #E7EDF5;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 500;
}

QLabel#modelDetailsDescription {
    color: #738199;
    font-size: 12px;
    font-weight: 400;
    background: transparent;
    border: none;
}

/* SKELETON */

QFrame#skeletonImage,
QFrame#skeletonLine,
QFrame#skeletonSpec,
QFrame#skeletonDescription {
    background-color: #E9EFF6;
    border: none;
    border-radius: 8px;
}

/* SCROLLBAR */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 2px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #1687F8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#modelDetailsContent {
    background-color: #FFFFFF;
    border: none;
}

QScrollArea#modelDetailsScroll,
QScrollArea#modelDetailsScroll QWidget#qt_scrollarea_viewport {
    background-color: #FFFFFF;
    border: none;
}