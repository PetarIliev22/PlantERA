QFrame#deviceModelsCard {
    background-color: #FFFFFF;
    border: 1px solid #F3F3F3;
    border-radius: 15px;
}

QLabel#deviceModelsTitle {
    background-color: transparent;
    border: none;
    color: #1687F8;
    font-size: 17px;
    font-weight: 700;
}

QPushButton#addModelButton {
    background-color: #1687F8;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 9px 16px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#addModelButton:hover {
    background-color: #0876E3;
}

QPushButton#addModelButton:pressed {
    background-color: #4277ac;
}

QListWidget#deviceModelsList {
    background-color: transparent;
    border: none;
    outline: none;
    spacing: 6px;
}

QListWidget#deviceModelsList::item {
    background-color: #F8FAFD;
    border: 1px solid #E7EDF5;
    border-radius: 10px;
}

QListWidget#deviceModelsList::item:hover {
    background-color: #EAF4FF;
    border: 1px solid #C7DEFA;
}

QListWidget#deviceModelsList::item:selected {
    background-color: #E3F0FF;
    border: 1px solid #1687F8;
}

QLabel#modelsLoadingText {
    background: transparent;
    color: #172B4D;
    font-size: 16px;
    font-weight: 600;
}

QLabel#modelsLoadingSubtitle {
    background: transparent;
    color: #738199;
    font-size: 12px;
    font-weight: 400;
}