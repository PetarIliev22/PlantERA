QFrame#sidebarProfile {
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-radius: 0;
}

QLabel#profileAvatar {
    background-color: #DBEAFE;
    color: #2563EB;
    border: none;
    border-radius: 21px;
    font-size: 16px;
    font-weight: 700;
}

QLabel#profileName {
    background: transparent;
    border: none;
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
}

QLabel#profileRole {
    background: transparent;
    border: none;
    color: #64748B;
    font-size: 10px;
    font-weight: 600;
}

QFrame#profileSeparator {
    background-color: #E2E8F0;
    border: none;
}

QPushButton#profileLogout {
    background-color: #FEF2F2;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
}

QPushButton#profileLogout:hover {
    background-color: #FEE2E2;
    border: 1px solid #FECACA;
}

QPushButton#profileLogout:pressed {
    background-color: #FECACA;
}