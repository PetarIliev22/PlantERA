QFrame#sidebar {
    background-color: #111827;
    border-image: url("assets/img/sidebar_effect.png") 0 0 0 0 stretch stretch;
}

QFrame#activeIndicator {
    background-color: #38BDF8;
    border: none;
    border-radius: 2px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    color: #A9B8CC;
    border: 1px solid transparent;
    border-radius: 12px;
    text-align: left;
    padding-left: 16px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#sidebarButton:hover {
    background-color: rgba(59, 130, 246, 0.12);
    color: #FFFFFF;
    border: 1px solid rgba(96, 165, 250, 0.16);
}

QPushButton#sidebarButton[active="true"] {
    background-color: rgba(22, 135, 248, 0.20);
    color: #FFFFFF;
    border: 1px solid rgba(56, 191, 248, 0.075);
}

QPushButton#sidebarButton[active="true"]:hover {
    background-color: rgba(22, 135, 248, 0.28);
    color: #FFFFFF;
    border: 1px solid rgba(56, 191, 248, 0.247);
}

QLabel#sidebarLogo {
    background: transparent;
    border: none;
}

QLabel#sidebarFooter {
    background-color: transparent;
    color: #718198;
    font-size: 11px;
    font-weight: 500;
}
