QFrame#sidebar {
    background-color: #2F425A;
    border: none;
    border-right: 1px solid #26384E;
}

QFrame#activeIndicator {
    background-color: #1687F8;
    border-radius: 2px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    color: #D5E1F0;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding-left: 13px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#sidebarButton:hover {
    background-color: #405B79;
    color: #FFFFFF;
}

QPushButton#sidebarButton[active="true"] {
    background-color: #176BC3;
    color: #FFFFFF;
}

QPushButton#sidebarButton[active="true"]:hover {
    background-color: #1687F8;
    color: #FFFFFF;
}

QLabel#sidebarFooter {
    background-color: transparent;
    color: #B5C5D9;
    font-size: 12px;
}