QWidget#authBlockedContainer {
    background-color: #ffffff;
    border-radius: 16px;
}

QLabel#authBlockedTitle {
    background: transparent;
    color: #EF4444;
    font-size: 24px;
    font-weight: 600;
}

QLabel#authBlockedDescription {
    background: transparent;
    color: #424242;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 16px;
}

QPushButton#authBlockButton {
    background-color: #EF4444;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#authBlockButton:hover {
    background-color: #DC2626;
}

QPushButton#authBlockButton:pressed {
    background-color: #B91C1C;
}

QPushButton#authBlockButton:disabled {
    background-color: #7F1D1D;
    color: #9CA3AF;
}