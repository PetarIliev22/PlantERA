QFrame#updateOverlay {
    background-color: rgba(4, 10, 20, 185);
    border: none;
}

QFrame#updateDialog {
    background-color: #ffffff;
    border: 1px solid #2B3D55;
    border-radius: 18px;
}

QLabel#updateTitle {
    color: #3a3a3a;
    font-size: 21px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#updateDescription {
    color: #4c5258;
    font-size: 13px;
    background: transparent;
    border: none;
}

QPushButton#updateButton {
    background-color: #1687F8;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton#updateButton:hover {
    background-color: #329AFF;
}

QPushButton#updateButton:pressed {
    background-color: #086ACB;
}

QPushButton#updateButton:disabled {
    background-color: #34445A;
    color: #A9B7CA;
}

QPushButton#laterButton {
    background-color: #1B293D;
    color: #ffffff;
    border: 1px solid #2B3D55;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton#laterButton:hover {
    background-color: #263A54;
    color: #FFFFFF;
    border-color: #3B5473;
}

QPushButton#laterButton:pressed {
    background-color: #142235;
}
