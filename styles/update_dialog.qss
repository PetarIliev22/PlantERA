
QFrame#updateOverlay {
    background-color: rgba(4, 10, 20, 185);
    border: none;
}

QFrame#updateDialog {
    background-color: #FFFFFF;
    border: 1px solid #2B3D55;
    border-radius: 18px;
}

QFrame#updateDialog QLabel#updateTitle {
    color: #081B45;
    font-size: 32px;
    font-weight: 800;
    background: transparent;
    border: none;
}

QLabel#updateDetails {
    color: #667A9C;
    font-size: 16px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QFrame#updateVersionBox {
    background-color: #EAF3FF;
    border: 1px solid #DCEBFF;
    border-radius: 14px;
}

QLabel#updateVersionIcon {
    background-color: #FFFFFF;
    border: none;
    border-radius: 12px;
}

QLabel#updateNewVersion {
    color: #0755D8;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#updateCurrentVersion {
    color: #536B97;
    font-size: 15px;
    background: transparent;
    border: none;
}

QPushButton#updateButton {
    background-color: #1687F8;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton#updateButton:hover {
    background-color: #329AFF;
}

QPushButton#updateButton:pressed {
    background-color: #086ACB;
}

QPushButton#updateButton:disabled {
    background-color: #34445A;
    color: #A9B7CA;
}

QPushButton#laterButton {
    background-color: #1B293D;
    color: #FFFFFF;
    border: 1px solid #2B3D55;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton#laterButton:hover {
    background-color: #263A54;
    color: #FFFFFF;
    border-color: #3B5473;
}

QPushButton#laterButton:pressed {
    background-color: #142235;
}

QLabel#updateWhatsNewTitle {
    color: #081B45;
    font-size: 19px;
    margin-top: 15px;
    font-weight: 700;
    background: transparent;
}

QScrollArea#updateWhatsNew {
    background: transparent;
    border: none;
}

QWidget#updateWhatsNewContainer {
    background: transparent;
}

QLabel#updateChangeText {
    color: #354767;
    font-size: 17px;
    background: transparent;
}



