QFrame#usersSummaryCard {
    background-color: #FFFFFF;
    border-radius: 12px;
}

QLabel#usersSummaryIcon {
    background-color: #F0F6FF;
    border: 2px solid #D6E6FA;
    border-radius: 24px;
}

QLabel#usersSummaryTitle {
    background: transparent;
    color: #64748B;
    font-size: 13px;
    font-weight: 500;
}

QLabel#usersSummaryValue {
    background: transparent;
    color: #0F172A;
    font-size: 28px;
    font-weight: 700;
}

QFrame#usersTableCard {
    background-color: #FFFFFF;
    border-radius: 12px;
}

QLabel#usersTableTitle {
    background: transparent;
    color: #0F172A;
    font-size: 20px;
    font-weight: 600;
}

QLabel#usersTableAvatar {
    background-color: #EFF6FF;
    border: 2px solid #D6E6FA;
    border-radius: 20px;
    color: #1687F8;
    font-size: 13px;
    font-weight: 600;
}

QLabel#usersTableName {
    background: transparent;
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
}

QTableWidget#usersTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #334155;
    font-size: 13px;
    outline: none;
}

QTableWidget#usersTable QHeaderView::section {
    background-color: #F1F5F9;
    color: #64748B;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 10px;
    font-size: 13px;
    font-weight: 600;
}

QTableWidget#usersTable::item {
    padding: 10px;
    border-bottom: 1px solid #E2E8F0;
}

QPushButton#usersActionButton {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

QPushButton#usersActionButton:hover {
    background-color: #E8F0FC;
    border-color: #CBD5E1;
}

QPushButton#usersActionButton:pressed {
    background-color: #D6E6FA;
}

QPushButton#usersActionButton:disabled {
    background-color: #F1F5F9;
    border-color: #E2E8F0;
}